# Python Service Environment Variables
# Copy this to .env and fill in your values

# Clerk JWKS URL — found in Clerk Dashboard → API Keys → Advanced
CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json

# Database — defaults to SQLite (no setup needed for local dev)
# For PostgreSQL: postgresql://user:password@localhost:5432/chalo_dekhe
DATABASE_URL=sqlite:///./stories.db

# Directory where uploaded photos are saved (relative to python-service/)
UPLOAD_DIR=./uploads

# Allowed frontend origin for CORS
ALLOWED_ORIGIN=http://localhost:5173

# Port for this service
PORT=3002
